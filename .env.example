# Supabase Postgres — pooled connection for the app at runtime (PgBouncer, port 6543)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Postgres — direct / session mode for Prisma migrate & db push (port 5432)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Supabase Auth (browser + SSR)
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
# Dashboard "anon" / "publishable" key — either name works in code
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Optional alias used by some Supabase docs; createClient falls back to this if ANON_KEY is unset
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Public site origin for auth email / OAuth redirects (optional; falls back to request host)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# After deploy: run supabase/avatars-bucket.sql in the Supabase SQL editor
# so profile photo uploads work (public bucket «avatars» + RLS policies).
#
# Phase 4: also run supabase/identity-docs-bucket.sql for private cédula/selfie uploads.
# Phase 5: run supabase/listing-images-bucket.sql for listing gallery + possession photos.
# Then: npm run db:seed  (iPhone models / colors / storages)
#
# Optional (reviewers): SUPABASE_SERVICE_ROLE_KEY enables signed previews of private
# identity docs on /revision/identidad. Never expose this key to the browser.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
#
# Promote a reviewer: see supabase/promote-reviewer.sql

# --- Phase 10: Payments (Wompi Colombia) ---
# Leave unset / mock locally to use in-app "Simular pago aprobado".
# PAYMENTS_PROVIDER=mock
# PAYMENTS_PROVIDER=wompi
#
# Sandbox setup checklist (do this before any real-card / link testing):
# 1. In https://comercios.wompi.co → Activar modo de pruebas.
# 2. Copy sandbox keys only (pub_test_ / prv_test_ / test_events_).
#    Never paste secrets into chat; put them in .env and Vercel env only.
# 3. Set the same trio + PAYMENTS_PROVIDER=wompi in Vercel (Preview + Production
#    while still on sandbox). Optional: WOMPI_INTEGRITY_SECRET.
# 4. Register Events URL in the Wompi dashboard (sandbox first):
#      https://true-phone.vercel.app/api/payments/wompi/webhook
#    Or for a custom domain: https://<your-domain>/api/payments/wompi/webhook
#    Localhost cannot receive Wompi webhooks — use the deployed URL (or a tunnel).
# 5. Do not switch to pub_prod_ / prv_prod_ until settlement (Phase 10b) is live.
#
# WOMPI_PUBLIC_KEY=pub_test_...
# WOMPI_PRIVATE_KEY=prv_test_...
# WOMPI_EVENTS_SECRET=test_events_...   # Event secret (not the private key)
# Optional (for Widget / integrity-signed checkout later):
# WOMPI_INTEGRITY_SECRET=test_integrity_...
# Optional overrides (defaults infer sandbox vs prod from pub_ key prefix):
# WOMPI_API_BASE_URL=https://sandbox.wompi.co/v1
# WOMPI_CHECKOUT_BASE_URL=https://checkout.wompi.co/l

# --- Phase 10b: Seller payouts (dispersion — separate from Checkout) ---
# Do NOT reuse Checkout pub_/prv_ keys here.
# MVP production: manual — Financial Core authorizes; you pay in Wompi dashboard;
# then mark completed in /revision/pagos. (Default when unset = manual.)
# PAYOUTS_PROVIDER=manual
# Local / CI auto-complete (no Wompi dashboard step):
# PAYOUTS_PROVIDER=mock
# Phase 24 — automated Pagos a Terceros API lotes (stub until product + keys):
# PAYOUTS_PROVIDER=wompi
# WOMPI_PAYOUTS_API_KEY=
# WOMPI_PAYOUTS_USER_PRINCIPAL_ID=
# WOMPI_PAYOUTS_ACCOUNT_ID=
# WOMPI_PAYOUTS_API_BASE_URL=https://api.payouts.wompi.co/v1
# Payout webhook (Phase 24 when API is activated):
#   https://<your-domain>/api/payments/wompi/payouts-webhook

# --- Phase 10d: Buyer confirm 24h auto-release cron ---
# Vercel Cron calls GET /api/cron/buyer-confirm-expiry hourly (see vercel.json).
# Generate a long random secret and set the same value in Vercel Project Settings.
# CRON_SECRET=replace-with-long-random-secret

