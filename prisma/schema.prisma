/**
 * @file schema.prisma
 * @description TruePhone Prisma data model: marketplace profiles, listings, orders, payments, financial core, shipping, reviews, and public listing Q&A.
 * @dependencies PostgreSQL 15+, Prisma Client, Supabase
 */

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Enums
enum UserRole {
  BUYER
  SELLER
  REVIEWER
  ADMIN
}

enum ListingStatus {
  DRAFT
  SUBMITTED
  PENDING_REVIEW
  APPROVED
  PUBLISHED
  RESERVED
  SOLD
  REJECTED
  ARCHIVED
}

enum Condition {
  FLAWLESS
  EXCELLENT
  GOOD
  FAIR
  POOR
}

/// Independent iPhone product lines. Numbered models, SE, and Air are not the same line.
enum IphoneProductLine {
  IPHONE
  IPHONE_SE
  IPHONE_AIR
}

/// Commercial variant within a product line (not a generation by itself).
enum IphoneVariantType {
  STANDARD
  MINI
  PLUS
  PRO
  PRO_MAX
  E
  AIR
}

enum IdentityVerificationStatus {
  DRAFT
  PENDING
  IN_REVIEW
  VERIFIED
  REJECTED
}

enum OrderStatus {
  AWAITING_PAYMENT
  PAID
  CANCELLED
  COMPLETED
}

/// Buyer-initiated delivery address change awaiting seller response.
enum OrderDeliveryAddressChangeStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum PaymentStatus {
  PENDING
  REQUIRES_ACTION
  SUCCEEDED
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentProvider {
  WOMPI
  MOCK
}

enum LedgerEntryType {
  PAYMENT_APPROVED
  HOLD_CREATED
  FEE_SNAPSHOT
  PAYOUT_AUTHORIZED
  PAYOUT_SUBMITTED
  PAYOUT_COMPLETED
  PAYOUT_FAILED
  REFUND_APPROVED
  REFUND_COMPLETED
  CHARGEBACK_RECEIVED
  DISPUTE_OPENED
  DISPUTE_RESOLVED
  BUYER_CONFIRMED
  BUYER_CONFIRM_EXPIRED
  SELLER_FULFILLMENT_ABANDONED
  PREMIUM_SHIPPING_FEE
}

enum PayoutStatus {
  PENDING
  AUTHORIZED
  SUBMITTED
  COMPLETED
  FAILED
  CANCELLED
}

enum PayoutProvider {
  WOMPI
  MOCK
  /// Ops pays in Wompi dashboard after Financial Core authorizes (MVP).
  MANUAL
}

enum FeeEntitlementStatus {
  ACTIVE
  USED
  REFUNDED
  EXPIRED
}

enum BankAccountType {
  AHORROS
  CORRIENTE
}

enum ShippingMethod {
  PREMIUM_BOGOTA
  CARRIER
}

enum ShipmentStatus {
  METHOD_SELECTED
  AWAITING_PICKUP
  INSPECTION
  IN_TRANSIT
  DELIVERED
  CANCELLED
  FAILED
  RETURNED
}

enum InspectionResult {
  PENDING
  PASSED
  FAILED
}

/// In-app / email notification kinds (Phase 12).
enum NotificationType {
  BUYER_RECEIVED_CONFIRM
  BUYER_CONFIRM_REMINDER
  LISTING_APPROVED
  LISTING_REJECTED
  IDENTITY_APPROVED
  IDENTITY_REJECTED
  ORDER_PAID
  NEW_MESSAGE
  SHIPPING_METHOD_CHOSEN
  TRACKING_UPLOADED
  PAYOUT_SENT
  ORDER_SUPPORT_REPLY
  ORDER_SUPPORT_STATUS
  SELLER_CANCELLATION_ACCEPTED
  BUYER_REMEDY_AVAILABLE
  REFUND_COMPLETED
  FULFILLMENT_ESCALATED
  LISTING_QUESTION_NEW
  LISTING_QUESTION_ANSWERED
  /// Seller must confirm iPhone still available before buyer checkout (F3).
  AVAILABILITY_HOLD_REQUEST
  AVAILABILITY_HOLD_CONFIRMED
  AVAILABILITY_HOLD_DENIED
  AVAILABILITY_HOLD_EXPIRED
  /// Multi-platform listing reminder on publish (F3).
  ALSO_LISTED_REMINDER
  /// Day 7 / 14 seller check-ins for unsold listings (F2).
  LISTING_CHECKIN_DAY7
  LISTING_CHECKIN_DAY14
}

/// Multi-platform buy-path hold before Wompi checkout (F3).
enum AvailabilityHoldStatus {
  PENDING
  CONFIRMED
  DENIED
  EXPIRED
}

/// Append-only audit kinds for availability holds (F3).
enum AvailabilityHoldEventKind {
  WARNING_ACK
  CREATED
  CONFIRMED
  DENIED
  EXPIRED
  LATE_CONFIRM
  PAYMENT_ATTEMPT
}

/// Seller-created workflow category for paid-order assistance.
enum OrderSupportCaseType {
  SELLER_CANCELLATION
  FULFILLMENT_EXCEPTION
  GENERAL_SUPPORT
}

/// Auditable lifecycle for a seller/staff order-support conversation.
enum OrderSupportCaseStatus {
  PENDING
  IN_REVIEW
  NEEDS_SELLER_RESPONSE
  ESCALATED
  APPROVED
  REJECTED
  RESOLVED
  WITHDRAWN
}

/// Ley 527 electronic acceptance audit trail source.
enum LegalAcceptanceSource {
  signup
  checkout
}

/// Public PQR channel case type (Peticiones, quejas y reclamos).
enum PqrCaseType {
  PETICION
  QUEJA
  RECLAMO
  RETRACTO
  HABEAS_DATA
  OTRO
}

/// Lifecycle for a consumer PQR case reviewed by staff.
enum PqrCaseStatus {
  PENDING
  IN_REVIEW
  RESPONDED
  CLOSED
}

/// Preferred public landing route after the marketing home first paint.
enum LandingPreference {
  HOME
  ANUNCIOS
}

// Models
model Profile {
  id                 String    @id @default(cuid())
  authUserId         String    @unique @map("auth_user_id")
  role               UserRole  @default(BUYER)
  fullName           String?
  username           String?   @unique
  avatarUrl          String?
  phone              String?
  city               String?
  department         String?
  bio                String?
  sellerRating       Float     @default(0)
  totalSales         Int       @default(0)
  totalReviews       Int       @default(0)
  isTrustedSeller    Boolean   @default(false)
  trustedSellerSince DateTime?
  verifikStatus      String    @default("not_submitted")
  verifikVerifiedAt  DateTime?
  landingPreference  LandingPreference @default(HOME) @map("landing_preference")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  listings                  Listing[]
  reviewsWritten            Review[]                @relation("ReviewWritten")
  reviewsReceived           Review[]                @relation("ReviewReceived")
  favorites                 Favorite[]
  sentMessages              Message[]               @relation("SentMessages")
  receivedMessages          Message[]               @relation("ReceivedMessages")
  reviewedListings          Listing[]               @relation("ReviewerListings")
  identityVerifications     IdentityVerification[]  @relation("SellerIdentity")
  identityReviews           IdentityVerification[]  @relation("IdentityReviewer")
  blocksCreated             UserBlock[]             @relation("BlocksCreated")
  blocksReceived            UserBlock[]             @relation("BlocksReceived")
  conversationReports       ConversationReport[]    @relation("ConversationReports")
  reviewReports             ReviewReport[]          @relation("ReviewReports")
  listingQuestionsAsked     ListingQuestion[]       @relation("ListingQuestionsAsked")
  listingQuestionAnswers    ListingQuestionAnswer[] @relation("ListingQuestionAnswers")
  listingQuestionReports    ListingQuestionReport[] @relation("ListingQuestionReports")
  listingViews              ListingViewEvent[]      @relation("ListingViewViewer")
  ordersAsBuyer             Order[]                 @relation("OrderBuyer")
  ordersAsSeller            Order[]                 @relation("OrderSeller")
  payments                  Payment[]
  sellerBankAccounts        SellerBankAccount[]
  feeEntitlements           FeeEntitlement[]        @relation("FeeEntitlementBuyer")
  payouts                   Payout[]
  notifications             Notification[]
  notificationPreference    NotificationPreference?
  orderSupportCasesAsSeller OrderSupportCase[]      @relation("OrderSupportSeller")
  assignedOrderSupportCases OrderSupportCase[]      @relation("OrderSupportAssignee")
  orderSupportMessages      OrderSupportMessage[]   @relation("OrderSupportMessageSender")
  pqrCasesSubmitted         PqrCase[]               @relation("PqrCaseSubmitter")
  assignedPqrCases          PqrCase[]               @relation("PqrCaseAssignee")
  pqrCasesResponded         PqrCase[]               @relation("PqrCaseResponder")
  legalAcceptances          LegalAcceptance[]
  deliveryAddressChangesRequested OrderDeliveryAddressChange[] @relation("DeliveryAddressChangeRequester")
  deliveryAddressChangesResponded OrderDeliveryAddressChange[] @relation("DeliveryAddressChangeResponder")
  availabilityHoldsAsBuyer        AvailabilityHold[]         @relation("AvailabilityHoldBuyer")

  @@map("profiles")
}

/// Electronic acceptance of terms and privacy (Ley 527 audit trail).
model LegalAcceptance {
  id               String                @id @default(cuid())
  userId           String                @map("user_id")
  user             Profile               @relation(fields: [userId], references: [id], onDelete: Cascade)
  termsVersionId   String                @map("terms_version_id")
  privacyVersionId String                @map("privacy_version_id")
  acceptedAt       DateTime              @default(now()) @map("accepted_at")
  source           LegalAcceptanceSource
  ipAddress        String?               @map("ip_address")
  userAgent        String?               @map("user_agent")

  @@index([userId])
  @@index([userId, source])
  @@index([acceptedAt])
  @@map("legal_acceptances")
}

model IdentityVerification {
  id                  String                     @id @default(cuid())
  profileId           String
  profile             Profile                    @relation("SellerIdentity", fields: [profileId], references: [id])
  status              IdentityVerificationStatus @default(DRAFT)
  documentType        String                     @default("cedula")
  documentNumberLast4 String?
  documentNumberHash  String?
  frontImageUrl       String?
  backImageUrl        String?
  selfieImageUrl      String?
  privacyAcceptedAt   DateTime?
  submittedAt         DateTime?
  reviewedAt          DateTime?
  reviewerId          String?
  reviewer            Profile?                   @relation("IdentityReviewer", fields: [reviewerId], references: [id])
  rejectionReason     String?
  provider            String                     @default("manual")
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  @@index([profileId])
  @@index([status])
  @@map("identity_verifications")
}

model IphoneModel {
  id                String               @id @default(cuid())
  name              String               @unique
  slug              String               @unique
  modelNumber       String?
  /// Independent line: numbered iPhone, SE, or Air. SE is never a 13/14 variant.
  productLine       IphoneProductLine
  /// Generation within the product line (SE 3/4, numbered 12–17, Air 1).
  generation        Int
  variantType       IphoneVariantType
  releaseYear       Int?
  /// Stable catalog order (1 = oldest in scope). Higher = newer for pickers.
  sortOrder         Int
  createdAt         DateTime             @default(now())
  listings          Listing[]
  modelColors       IphoneModelColor[]
  modelStorages     IphoneModelStorage[]
  recommendedPrices RecommendedPrice[]

  @@unique([productLine, generation, variantType])
  @@index([productLine, generation])
  @@index([sortOrder])
  @@index([releaseYear])
  @@map("iphone_models")
}

model IphoneColor {
  id          String             @id @default(cuid())
  name        String             @unique
  hex         String?
  createdAt   DateTime           @default(now())
  listings    Listing[]
  modelColors IphoneModelColor[]

  @@map("iphone_colors")
}

/// Allowed colors per iPhone model (listing wizard filter).
model IphoneModelColor {
  id            String      @id @default(cuid())
  iphoneModelId String
  iphoneModel   IphoneModel @relation(fields: [iphoneModelId], references: [id], onDelete: Cascade)
  iphoneColorId String
  iphoneColor   IphoneColor @relation(fields: [iphoneColorId], references: [id], onDelete: Cascade)

  @@unique([iphoneModelId, iphoneColorId])
  @@index([iphoneModelId])
  @@index([iphoneColorId])
  @@map("iphone_model_colors")
}

/// Allowed storage capacities per iPhone model (listing wizard filter).
model IphoneModelStorage {
  id              String        @id @default(cuid())
  iphoneModelId   String
  iphoneModel     IphoneModel   @relation(fields: [iphoneModelId], references: [id], onDelete: Cascade)
  iphoneStorageId String
  iphoneStorage   IphoneStorage @relation(fields: [iphoneStorageId], references: [id], onDelete: Cascade)

  @@unique([iphoneModelId, iphoneStorageId])
  @@index([iphoneModelId])
  @@index([iphoneStorageId])
  @@map("iphone_model_storages")
}

model IphoneStorage {
  id                String               @id @default(cuid())
  valueGb           Int                  @unique
  createdAt         DateTime             @default(now())
  listings          Listing[]
  modelStorages     IphoneModelStorage[]
  recommendedPrices RecommendedPrice[]

  @@map("iphone_storages")
}

/// Admin-maintained pricing guide for sellers (model + storage + condition → COP).
/// Guidance only — never forces listing price. Phase 13 CRUD; Phase 5 seller display.
model RecommendedPrice {
  id              String        @id @default(cuid())
  iphoneModelId   String
  iphoneModel     IphoneModel   @relation(fields: [iphoneModelId], references: [id], onDelete: Cascade)
  iphoneStorageId String
  iphoneStorage   IphoneStorage @relation(fields: [iphoneStorageId], references: [id], onDelete: Cascade)
  condition       Condition
  /// Reference sale price in integer COP pesos.
  priceCop        Int
  minPriceCop     Int?
  maxPriceCop     Int?
  notes           String?
  effectiveFrom   DateTime?
  effectiveTo     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([iphoneModelId, iphoneStorageId, condition])
  @@index([iphoneModelId])
  @@index([condition])
  @@map("recommended_prices")
}

model Listing {
  id         String   @id @default(cuid())
  sellerId   String
  seller     Profile  @relation(fields: [sellerId], references: [id])
  reviewerId String?
  reviewer   Profile? @relation("ReviewerListings", fields: [reviewerId], references: [id])

  iphoneModelId   String
  iphoneModel     IphoneModel   @relation(fields: [iphoneModelId], references: [id])
  iphoneColorId   String
  iphoneColor     IphoneColor   @relation(fields: [iphoneColorId], references: [id])
  iphoneStorageId String
  iphoneStorage   IphoneStorage @relation(fields: [iphoneStorageId], references: [id])

  title         String
  slug          String    @unique
  description   String?
  condition     Condition
  batteryHealth Int?

  price       Int
  platformFee Int?
  finalPrice  Int?

  imeiLast4        String?
  imeiHash         String? @unique
  activationLocked Boolean @default(false)
  unlocked         Boolean @default(true)
  carrier          String?

  hasBox     Boolean @default(false)
  hasCharger Boolean @default(false)
  hasReceipt Boolean @default(false)

  status          ListingStatus @default(DRAFT)
  reviewerNotes   String?
  rejectionReason String?
  reviewedAt      DateTime?
  approvedAt      DateTime?
  /// First publish timestamp (F2); legacy rows backfilled from approvedAt.
  publishedAt       DateTime?
  /// Price baseline at publish for silent boost drops (F2).
  priceAtPublish    Int?
  /// Silent Destacados boost window — never disclosed to seller (F2).
  boostUntil        DateTime?
  /// Seller disclosed listing on other platforms (F3).
  alsoListedElsewhere Boolean @default(false)

  searchVector Unsupported("tsvector")?
  /// Denormalized unique-visitor-day count from ListingViewEvent (Phase 15).
  views        Int                      @default(0)
  deletedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images              ListingImage[]
  favorites           Favorite[]
  messages            Message[]
  conversationReports ConversationReport[]
  questions           ListingQuestion[]
  viewEvents          ListingViewEvent[]
  possessionChallenge DevicePossessionChallenge?
  orders              Order[]
  availabilityHolds   AvailabilityHold[]

  @@index([status])
  @@index([sellerId])
  @@index([views])
  @@index([publishedAt])
  @@index([boostUntil])
  @@index([status, publishedAt, id])
  @@map("listings")
}

/// Pre-checkout seller availability confirmation for multi-platform listings (F3).
model AvailabilityHold {
  id        String                 @id @default(cuid())
  listingId String                 @map("listing_id")
  listing   Listing                @relation(fields: [listingId], references: [id], onDelete: Restrict)
  buyerId   String                 @map("buyer_id")
  buyer     Profile                @relation("AvailabilityHoldBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  status    AvailabilityHoldStatus @default(PENDING)

  /// PENDING window end (2h from creation).
  expiresAt       DateTime  @map("expires_at")
  /// Checkout unlock end after CONFIRMED (~30m).
  unlockExpiresAt DateTime? @map("unlock_expires_at")
  confirmedAt     DateTime? @map("confirmed_at")
  deniedAt        DateTime? @map("denied_at")
  expiredAt       DateTime? @map("expired_at")

  orderId String? @unique @map("order_id")
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  events AvailabilityHoldEvent[]

  @@index([listingId, status])
  @@index([buyerId, status])
  @@index([expiresAt])
  @@map("availability_holds")
}

/// Append-only audit trail for availability holds (F3).
model AvailabilityHoldEvent {
  id               String                    @id @default(cuid())
  holdId           String                    @map("hold_id")
  hold             AvailabilityHold          @relation(fields: [holdId], references: [id], onDelete: Cascade)
  kind             AvailabilityHoldEventKind
  actorId          String?                   @map("actor_id")
  paymentAttemptId String?                   @map("payment_attempt_id")
  metadata         Json?
  createdAt        DateTime                  @default(now()) @map("created_at")

  @@index([holdId, createdAt])
  @@map("availability_hold_events")
}

/// Durable listing view for ops analytics (Phase 15). One row per visitor per listing per UTC day.
model ListingViewEvent {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  viewerId  String?
  viewer    Profile? @relation("ListingViewViewer", fields: [viewerId], references: [id], onDelete: SetNull)
  /// `u:{profileId}` or `h:{sha256 prefix}` so guests and members share one unique key.
  dedupeKey String
  viewedOn  DateTime @db.Date
  createdAt DateTime @default(now())

  @@unique([listingId, dedupeKey, viewedOn])
  @@index([listingId, createdAt])
  @@index([createdAt])
  @@index([viewerId])
  @@map("listing_view_events")
}

model DevicePossessionChallenge {
  id         String    @id @default(cuid())
  listingId  String    @unique
  listing    Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  code       String
  photoUrl   String?
  verifiedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("device_possession_challenges")
}

model ListingImage {
  id           String   @id @default(cuid())
  listingId    String
  listing      Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  imageUrl     String
  imageType    String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  @@map("listing_images")
}

model Message {
  id         String   @id @default(cuid())
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id])
  senderId   String
  sender     Profile  @relation("SentMessages", fields: [senderId], references: [id])
  receiverId String
  receiver   Profile  @relation("ReceivedMessages", fields: [receiverId], references: [id])
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([receiverId, isRead])
  @@index([listingId, createdAt])
  @@index([senderId, listingId])
  @@map("messages")
}

/// One-way block: blocker cannot be messaged by (and should not message) blocked.
model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blocker   Profile  @relation("BlocksCreated", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   Profile  @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

/// Public question on a published listing (Phase 8b). Distinct from private Message threads.
model ListingQuestion {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  askerId   String
  asker     Profile @relation("ListingQuestionsAsked", fields: [askerId], references: [id])
  body      String
  /// Soft-hide for staff moderation; omitted from public listing Q&A.
  hiddenAt   DateTime?
  hiddenById String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  answer  ListingQuestionAnswer?
  reports ListingQuestionReport[]

  @@index([listingId, createdAt])
  @@index([askerId])
  @@map("listing_questions")
}

/// Seller's official answer to a public listing question. One answer per question.
model ListingQuestionAnswer {
  id         String          @id @default(cuid())
  questionId String          @unique
  question   ListingQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  sellerId   String
  seller     Profile         @relation("ListingQuestionAnswers", fields: [sellerId], references: [id])
  body       String
  hiddenAt   DateTime?
  hiddenById String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  reports ListingQuestionReport[]

  @@index([sellerId])
  @@map("listing_question_answers")
}

/// Report a public listing question or answer for staff moderation.
model ListingQuestionReport {
  id         String           @id @default(cuid())
  questionId String?
  question   ListingQuestion? @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answerId   String?
  answer     ListingQuestionAnswer? @relation(fields: [answerId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   Profile          @relation("ListingQuestionReports", fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String
  createdAt  DateTime         @default(now())
  resolvedAt DateTime?
  resolvedById String?

  @@index([questionId])
  @@index([answerId])
  @@index([reporterId])
  @@index([resolvedAt])
  @@map("listing_question_reports")
}

/// Report a listing-scoped conversation for moderation.
model ConversationReport {
  id         String   @id @default(cuid())
  reporterId String
  reporter   Profile  @relation("ConversationReports", fields: [reporterId], references: [id], onDelete: Cascade)
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reason     String
  createdAt  DateTime @default(now())

  @@index([listingId])
  @@index([reporterId])
  @@map("conversation_reports")
}

/// Order-tied marketplace rating (Phase 11). One review per participant per order.
model Review {
  id             String    @id @default(cuid())
  orderId        String
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  reviewerId     String
  reviewer       Profile   @relation("ReviewWritten", fields: [reviewerId], references: [id])
  reviewedUserId String
  reviewedUser   Profile   @relation("ReviewReceived", fields: [reviewedUserId], references: [id])
  rating         Int // 1-5
  comment        String?
  /// Soft-hide for moderation; excluded from public averages.
  hiddenAt       DateTime?
  hiddenById     String?
  createdAt      DateTime  @default(now())

  reports ReviewReport[]

  @@unique([orderId, reviewerId])
  @@index([orderId])
  @@index([reviewedUserId, createdAt])
  @@map("reviews")
}

/// Report an abusive marketplace review for staff moderation.
model ReviewReport {
  id           String    @id @default(cuid())
  reviewId     String
  review       Review    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporterId   String
  reporter     Profile   @relation("ReviewReports", fields: [reporterId], references: [id], onDelete: Cascade)
  reason       String
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedById String?

  @@index([reviewId])
  @@index([reporterId])
  @@index([resolvedAt])
  @@map("review_reports")
}

model Order {
  id        String      @id @default(cuid())
  listingId String
  listing   Listing     @relation(fields: [listingId], references: [id])
  buyerId   String
  buyer     Profile     @relation("OrderBuyer", fields: [buyerId], references: [id])
  sellerId  String
  seller    Profile     @relation("OrderSeller", fields: [sellerId], references: [id])
  status    OrderStatus @default(AWAITING_PAYMENT)

  /// Snapshots at reserve time (COP, integer pesos).
  equipmentPrice Int
  platformFee    Int
  totalPrice     Int
  currency       String @default("COP")

  /// Marketplace fee rate in basis points (1000 = 10%, 800 = 8% loyalty).
  feeRateBps              Int @default(1000)
  /// Projected Wompi collection cost (2.75% + IVA) on buyer total.
  wompiCollectionPesos    Int @default(0)
  /// Projected Wompi payout cost (0.45% + IVA) on seller amount.
  wompiPayoutPesos        Int @default(0)
  /// Remainder of fee pool after Wompi costs.
  truephoneRevenuePesos   Int @default(0)
  /// Amount obligated to seller on hold / dispersed at payout.
  sellerAmountPesos       Int @default(0)
  /// Premium Bogotá logistics fee deducted from seller (0 for Carrier).
  premiumShippingFeePesos Int @default(0)
  /// Reserved for post-MVP seller marketplace fee (always 0 in MVP).
  sellerFeePesos          Int @default(0)

  /// Financial Core settlement timestamps (PAID = hold active).
  fundsHeldAt                  DateTime?
  payoutAuthorizedAt           DateTime?
  payoutCompletedAt            DateTime?
  buyerConfirmedAt             DateTime?
  /// Set when Shipping marks delivered; silence until then → auto-release.
  buyerConfirmDeadlineAt       DateTime?
  payoutFrozen                 Boolean   @default(false)
  sellerFulfillmentAbandonedAt DateTime?

  cancelReason  String?
  cancelledAt   DateTime?
  cancelledById String?
  completedAt   DateTime?
  paidAt        DateTime?

  /// Delivery snapshot (draft until payment; frozen at paidAt).
  deliveryRecipientName   String?   @map("delivery_recipient_name")
  deliveryPhone           String?   @map("delivery_phone")
  deliveryCity            String?   @map("delivery_city")
  deliveryDepartment      String?   @map("delivery_department")
  deliveryAddressLine     String?   @map("delivery_address_line")
  deliveryNotes           String?   @map("delivery_notes")
  deliveryAddressFrozenAt DateTime? @map("delivery_address_frozen_at")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews              Review[]
  deliveryAddressChanges OrderDeliveryAddressChange[]
  payments             Payment[]
  ledgerEntries        LedgerEntry[]
  payouts              Payout[]
  shipment             Shipment?
  feeEntitlementSource FeeEntitlement?    @relation("FeeEntitlementSourceOrder")
  feeEntitlementUsed   FeeEntitlement?    @relation("FeeEntitlementUsedOrder")
  notifications        Notification[]
  supportCases         OrderSupportCase[]
  pqrCases             PqrCase[]
  availabilityHold     AvailabilityHold?

  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
  @@index([listingId])
  @@index([status])
  @@index([status, updatedAt])
  @@index([buyerConfirmDeadlineAt])
  @@map("orders")
}

/// Auditable buyer/seller delivery address change on a paid order.
model OrderDeliveryAddressChange {
  id      String                           @id @default(cuid())
  orderId String                           @map("order_id")
  order   Order                            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  status  OrderDeliveryAddressChangeStatus @default(PENDING)

  requestedById String  @map("requested_by_id")
  requestedBy   Profile @relation("DeliveryAddressChangeRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  respondedById String? @map("responded_by_id")
  respondedBy   Profile? @relation("DeliveryAddressChangeResponder", fields: [respondedById], references: [id], onDelete: SetNull)

  oldRecipientName String  @map("old_recipient_name")
  oldPhone         String  @map("old_phone")
  oldCity          String  @map("old_city")
  oldDepartment    String  @map("old_department")
  oldAddressLine   String  @map("old_address_line")
  oldNotes         String? @map("old_notes")

  newRecipientName String  @map("new_recipient_name")
  newPhone         String  @map("new_phone")
  newCity          String  @map("new_city")
  newDepartment    String  @map("new_department")
  newAddressLine   String  @map("new_address_line")
  newNotes         String? @map("new_notes")

  createdAt   DateTime  @default(now()) @map("created_at")
  respondedAt DateTime? @map("responded_at")

  @@index([orderId, status])
  @@index([orderId, createdAt])
  @@map("order_delivery_address_changes")
}

/// Seller-initiated, order-scoped support workflow reviewed by trusted staff.
model OrderSupportCase {
  id              String                 @id @default(cuid())
  orderId         String
  order           Order                  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sellerId        String
  seller          Profile                @relation("OrderSupportSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  type            OrderSupportCaseType
  status          OrderSupportCaseStatus @default(PENDING)
  initialReason   String
  assignedStaffId String?
  assignedStaff   Profile?               @relation("OrderSupportAssignee", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  decisionNote    String?
  reviewedAt      DateTime?
  resolvedAt      DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  messages OrderSupportMessage[]

  @@index([status, createdAt])
  @@index([type, status, createdAt])
  @@index([orderId, status])
  @@index([assignedStaffId, status])
  @@map("order_support_cases")
}

/// Seller/staff message or private internal note within an order-support case.
model OrderSupportMessage {
  id         String           @id @default(cuid())
  caseId     String
  case       OrderSupportCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  senderId   String
  sender     Profile          @relation("OrderSupportMessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  body       String
  isInternal Boolean          @default(false)
  createdAt  DateTime         @default(now())

  @@index([caseId, createdAt])
  @@index([senderId, createdAt])
  @@map("order_support_messages")
}

/// Consumer PQR case (retracto, quejas, peticiones) with readable radicado id.
model PqrCase {
  id              String        @id @default(cuid())
  radicado        String        @unique
  tipo            PqrCaseType
  status          PqrCaseStatus @default(PENDING)
  fullName        String
  email           String
  userId          String?
  user            Profile?      @relation("PqrCaseSubmitter", fields: [userId], references: [id], onDelete: SetNull)
  orderId         String?
  order           Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  body            String
  attachments     Json?
  respuesta       String?
  respondedAt     DateTime?
  respondedById   String?
  respondedBy     Profile?      @relation("PqrCaseResponder", fields: [respondedById], references: [id], onDelete: SetNull)
  assignedStaffId String?
  assignedStaff   Profile?      @relation("PqrCaseAssignee", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([tipo, status, createdAt])
  @@index([assignedStaffId, status])
  @@map("pqr_cases")
}

/// Device fulfillment (Phase 10c). One shipment per order. Does not authorize money.
model Shipment {
  id      String         @id @default(cuid())
  orderId String         @unique
  order   Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  method  ShippingMethod
  status  ShipmentStatus @default(METHOD_SELECTED)

  /// Carrier path (Servientrega / Envía / other).
  carrierName  String?
  trackingCode String?
  evidenceUrl  String?

  /// Premium Bogotá: fee snapshot at method selection (current fee when Premium).
  premiumFeeCop Int @default(0)

  methodSelectedAt   DateTime  @default(now())
  trackingUploadedAt DateTime?
  pickupScheduledAt  DateTime?
  inspectionAt       DateTime?
  inTransitAt        DateTime?
  deliveredAt        DateTime?
  failedAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inspection ShipmentInspection?

  @@index([status])
  @@index([method])
  @@map("shipments")
}

/// Premium Bogotá inspection checklist (Phase 10c).
model ShipmentInspection {
  id         String           @id @default(cuid())
  shipmentId String           @unique
  shipment   Shipment         @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  result     InspectionResult @default(PENDING)

  imeiMatch        Boolean?
  serialMatch      Boolean?
  storageMatch     Boolean?
  colorMatch       Boolean?
  cosmeticNotes    String?
  accessoriesOk    Boolean?
  batteryHealthPct Int?
  notes            String?

  inspectedById String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("shipment_inspections")
}

/// Append-only money facts. Financial Core is the only writer.
model LedgerEntry {
  id          String          @id @default(cuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentId   String?
  payoutId    String?
  payout      Payout?         @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  type        LedgerEntryType
  /// Signed COP pesos: positive = inflow to TruePhone/Cuenta obligation; see metadata for semantics.
  amountPesos Int
  currency    String          @default("COP")
  memo        String?
  metadata    Json?
  createdAt   DateTime        @default(now())

  @@index([orderId, createdAt])
  @@index([type, createdAt])
  @@index([payoutId])
  @@map("ledger_entries")
}

/// Seller bank destination for Pagos a Terceros (MVP bank only).
model SellerBankAccount {
  id            String          @id @default(cuid())
  profileId     String
  profile       Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  legalIdType   String
  legalId       String
  bankCode      String
  bankName      String?
  accountType   BankAccountType
  accountNumber String
  holderName    String
  email         String
  isDefault     Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  payouts Payout[]

  @@index([profileId])
  @@map("seller_bank_accounts")
}

/// Dispersion from Wompi Cuenta → seller bank (Financial Core only).
model Payout {
  id                  String             @id @default(cuid())
  orderId             String
  order               Order              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sellerId            String
  seller              Profile            @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  sellerBankAccountId String?
  sellerBankAccount   SellerBankAccount? @relation(fields: [sellerBankAccountId], references: [id], onDelete: SetNull)
  provider            PayoutProvider
  status              PayoutStatus       @default(PENDING)
  amountPesos         Int
  currency            String             @default("COP")
  idempotencyKey      String             @unique
  providerPayoutId    String?
  providerLoteId      String?
  failureCode         String?
  failureMessage      String?
  authorizedAt        DateTime?
  submittedAt         DateTime?
  completedAt         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  ledgerEntries LedgerEntry[]

  @@index([orderId, createdAt])
  @@index([sellerId, createdAt])
  @@index([status])
  @@map("payouts")
}

/// One-time 8% marketplace fee after seller cancel / no-ship.
model FeeEntitlement {
  id             String               @id @default(cuid())
  buyerId        String
  buyer          Profile              @relation("FeeEntitlementBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  sourceOrderId  String               @unique
  sourceOrder    Order                @relation("FeeEntitlementSourceOrder", fields: [sourceOrderId], references: [id], onDelete: Restrict)
  status         FeeEntitlementStatus @default(ACTIVE)
  /// Always 800 (8%) for MVP loyalty path.
  feeRateBps     Int                  @default(800)
  usedAt         DateTime?
  usedOnOrderId  String?              @unique
  usedOnOrder    Order?               @relation("FeeEntitlementUsedOrder", fields: [usedOnOrderId], references: [id], onDelete: SetNull)
  refundChosenAt DateTime?
  expiresAt      DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([buyerId, status])
  @@map("fee_entitlements")
}

/// Buyer checkout for Compra Garantizada (equipment + marketplace fee).
model Payment {
  id      String  @id @default(cuid())
  orderId String
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  buyerId String
  buyer   Profile @relation(fields: [buyerId], references: [id], onDelete: Restrict)

  provider PaymentProvider
  status   PaymentStatus   @default(PENDING)

  /// Amount charged to the buyer in COP pesos (= order.totalPrice).
  amount         Int
  currency       String @default("COP")
  equipmentPrice Int
  platformFee    Int

  /// Stable merchant reference sent to the provider.
  reference          String  @unique
  providerPaymentId  String?
  providerCheckoutId String?
  checkoutUrl        String?

  failureCode    String?
  failureMessage String?

  paidAt       DateTime?
  refundedAt   DateTime?
  refundAmount Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  webhookEvents PaymentWebhookEvent[]

  @@index([orderId, createdAt])
  @@index([buyerId, createdAt])
  @@index([status])
  @@index([providerCheckoutId])
  @@index([providerPaymentId])
  @@map("payments")
}

/// Idempotent store of provider webhook deliveries.
model PaymentWebhookEvent {
  id               String          @id @default(cuid())
  provider         PaymentProvider
  eventType        String
  /// Unique key for idempotency (e.g. checksum + timestamp).
  externalEventKey String
  payload          Json
  paymentId        String?
  payment          Payment?        @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  processedAt      DateTime?
  processingError  String?
  createdAt        DateTime        @default(now())

  @@unique([provider, externalEventKey])
  @@index([paymentId])
  @@map("payment_webhook_events")
}

model Favorite {
  id        String  @id @default(cuid())
  userId    String
  user      Profile @relation(fields: [userId], references: [id])
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@map("favorites")
}

/// In-app notification row (Phase 12). Email delivery is tracked on the same row.
model Notification {
  id          String           @id @default(cuid())
  userId      String
  user        Profile          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        NotificationType
  title       String
  body        String
  /// Relative app path (e.g. /compras/{orderId}).
  href        String?
  orderId     String?
  order       Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  readAt      DateTime?
  emailSentAt DateTime?
  /// Idempotency key (e.g. buyer-received:{orderId}).
  dedupeKey   String           @unique
  createdAt   DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([orderId])
  @@map("notifications")
}

/// Per-user channel preferences for notifications (defaults = all on).
model NotificationPreference {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailEnabled      Boolean  @default(true)
  emailOrderUpdates Boolean  @default(true)
  inAppEnabled      Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("notification_preferences")
}
