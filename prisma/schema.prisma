generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Enums
enum UserRole {
  BUYER
  SELLER
  REVIEWER
  ADMIN
}

enum ListingStatus {
  DRAFT
  SUBMITTED
  PENDING_REVIEW
  APPROVED
  PUBLISHED
  RESERVED
  SOLD
  REJECTED
  ARCHIVED
}

enum Condition {
  FLAWLESS
  EXCELLENT
  GOOD
  FAIR
  POOR
}

enum IdentityVerificationStatus {
  DRAFT
  PENDING
  IN_REVIEW
  VERIFIED
  REJECTED
}

// Models
model Profile {
  id                  String      @id @default(cuid())
  authUserId          String      @unique @map("auth_user_id")
  role                UserRole    @default(BUYER)
  fullName            String?
  username            String?     @unique
  avatarUrl           String?
  phone               String?
  city                String?
  department          String?
  bio                 String?
  sellerRating        Float       @default(0)
  totalSales          Int         @default(0)
  totalReviews        Int         @default(0)
  isTrustedSeller     Boolean     @default(false)
  trustedSellerSince  DateTime?
  verifikStatus       String      @default("not_submitted")
  verifikVerifiedAt   DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  listings               Listing[]
  reviewsWritten         Review[]                 @relation("ReviewWritten")
  reviewsReceived        Review[]                 @relation("ReviewReceived")
  favorites              Favorite[]
  sentMessages           Message[]                @relation("SentMessages")
  receivedMessages       Message[]                @relation("ReceivedMessages")
  reviewedListings       Listing[]                @relation("ReviewerListings")
  identityVerifications  IdentityVerification[]   @relation("SellerIdentity")
  identityReviews        IdentityVerification[]   @relation("IdentityReviewer")

  @@map("profiles")
}

model IdentityVerification {
  id                   String                      @id @default(cuid())
  profileId            String
  profile              Profile                     @relation("SellerIdentity", fields: [profileId], references: [id])
  status               IdentityVerificationStatus  @default(DRAFT)
  documentType         String                      @default("cedula")
  documentNumberLast4  String?
  documentNumberHash   String?
  frontImageUrl        String?
  backImageUrl         String?
  selfieImageUrl       String?
  privacyAcceptedAt    DateTime?
  submittedAt          DateTime?
  reviewedAt           DateTime?
  reviewerId           String?
  reviewer             Profile?                    @relation("IdentityReviewer", fields: [reviewerId], references: [id])
  rejectionReason      String?
  provider             String                      @default("manual")
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  @@index([profileId])
  @@index([status])
  @@map("identity_verifications")
}

model IphoneModel {
  id          String            @id @default(cuid())
  name        String            @unique
  slug        String            @unique
  modelNumber String?
  releaseYear Int?
  createdAt   DateTime          @default(now())
  listings    Listing[]
  modelColors IphoneModelColor[]

  @@map("iphone_models")
}

model IphoneColor {
  id          String            @id @default(cuid())
  name        String            @unique
  hex         String?
  createdAt   DateTime          @default(now())
  listings    Listing[]
  modelColors IphoneModelColor[]

  @@map("iphone_colors")
}

/// Allowed colors per iPhone model (listing wizard filter).
model IphoneModelColor {
  id            String      @id @default(cuid())
  iphoneModelId String
  iphoneModel   IphoneModel @relation(fields: [iphoneModelId], references: [id], onDelete: Cascade)
  iphoneColorId String
  iphoneColor   IphoneColor @relation(fields: [iphoneColorId], references: [id], onDelete: Cascade)

  @@unique([iphoneModelId, iphoneColorId])
  @@index([iphoneModelId])
  @@index([iphoneColorId])
  @@map("iphone_model_colors")
}

model IphoneStorage {
  id        String    @id @default(cuid())
  valueGb   Int       @unique
  createdAt DateTime  @default(now())
  listings  Listing[]
  @@map("iphone_storages")
}

model Listing {
  id                  String         @id @default(cuid())
  sellerId            String
  seller              Profile        @relation(fields: [sellerId], references: [id])
  reviewerId          String?
  reviewer            Profile?       @relation("ReviewerListings", fields: [reviewerId], references: [id])

  iphoneModelId       String
  iphoneModel         IphoneModel    @relation(fields: [iphoneModelId], references: [id])
  iphoneColorId       String
  iphoneColor         IphoneColor    @relation(fields: [iphoneColorId], references: [id])
  iphoneStorageId     String
  iphoneStorage       IphoneStorage  @relation(fields: [iphoneStorageId], references: [id])

  title               String
  slug                String         @unique
  description         String?
  condition           Condition
  batteryHealth       Int?

  price               Int
  platformFee         Int?
  finalPrice          Int?

  imeiLast4           String?
  imeiHash            String?        @unique
  activationLocked    Boolean        @default(false)
  unlocked            Boolean        @default(true)
  carrier             String?

  hasBox              Boolean        @default(false)
  hasCharger          Boolean        @default(false)
  hasReceipt          Boolean        @default(false)

  status              ListingStatus  @default(DRAFT)
  reviewerNotes       String?
  rejectionReason     String?
  reviewedAt          DateTime?
  approvedAt          DateTime?

  searchVector        Unsupported("tsvector")?
  views               Int            @default(0)
  deletedAt           DateTime?

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  images              ListingImage[]
  favorites           Favorite[]
  messages            Message[]
  possessionChallenge DevicePossessionChallenge?

  @@index([status])
  @@index([sellerId])
  @@map("listings")
}

model DevicePossessionChallenge {
  id         String    @id @default(cuid())
  listingId  String    @unique
  listing    Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  code       String
  photoUrl   String?
  verifiedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("device_possession_challenges")
}

model ListingImage {
  id           String   @id @default(cuid())
  listingId    String
  listing      Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  imageUrl     String
  imageType    String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  @@map("listing_images")
}

model Message {
  id          String   @id @default(cuid())
  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id])
  senderId    String
  sender      Profile  @relation("SentMessages", fields: [senderId], references: [id])
  receiverId  String
  receiver    Profile  @relation("ReceivedMessages", fields: [receiverId], references: [id])
  content     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("messages")
}
model Review {
  id             String   @id @default(cuid())
  orderId        String?  // Will link to Order later
  reviewerId     String
  reviewer       Profile  @relation("ReviewWritten", fields: [reviewerId], references: [id])
  reviewedUserId String
  reviewedUser   Profile  @relation("ReviewReceived", fields: [reviewedUserId], references: [id])
  rating         Int      // 1-5
  comment        String?
  createdAt      DateTime @default(now())

  @@map("reviews")
}
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      Profile  @relation(fields: [userId], references: [id])
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@map("favorites")
}